# Credentials — never commit these
config.local.php
access_config.local.php
deploy/
*.settings.json

# Generated item pages (rebuild: scripts/build_item_urls.php)
skins/
cases/
stickers/
agents/
charms/
graffiti/
patches/
pins/
music/
music-kits/
collections/
collectibles/
misc/

# Price and marketplace caches (repopulated by the sync scripts).
# roi_catalog.json is the exception: it is the catalogue the search and
# browse endpoints read, so without it a clone serves pages that return no
# items. 27 MB is worth it for a repo someone is meant to be able to run.
assets/*-cache/
!assets/steam-market-cache/
assets/steam-market-cache/*
!assets/steam-market-cache/roi_catalog.json
assets/cache/
assets/*.log

# assets/data holds the catalogue indexes the app reads at runtime, so those
# ARE committed. Only the backups and the TF2 sister-site data are excluded.
assets/data/*.bak*
assets/data/tf2/

# 3D models (regenerate: scripts/export_base_weapon_models.ps1)
assets/models/

# Scratch and debug artifacts
_tmp_*
tmp_*
*_harness*
*-harness*
*.bak
test-results/
.tmp-*/

# Tooling
node_modules/
__pycache__/
*.zip
