/* ---------------- Base ---------------- */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: Arial, sans-serif;
  background: #020617;
  color: #fff;
  padding: 50px 40px;
}

/* ---------- Header ---------- */
header {
  text-align: center;
  margin-bottom: 30px;
}

header h1 {
  font-size: 36px;
  font-weight: bold;
  margin-bottom: 8px;
}

header p {
  font-size: 14px;
  opacity: .85;
  max-width: 900px;
  margin:auto;
}

/* ---------- Search / Sort Bar ---------- */
.search-bar {
  display: flex;
  gap: 12px;
  margin: 26px auto 40px;
  max-width: 1200px;
  flex-wrap: wrap;
}

.search-bar input,
.search-bar select {
  flex: 1;
  min-width: 220px;
  padding: 10px 14px;
  font-size: 14px;
  border-radius: 8px;
  border: none;
  background: rgba(255,255,255,0.06);
  color: #fff;
}

.search-bar input::placeholder {
  color: rgba(255,255,255,0.7);
}

.results-meta {
  max-width: 1500px;
  margin: 0 auto 18px;
  color: rgba(191, 219, 254, 0.78);
  font-size: 13px;
  font-weight: 600;
}

.catalog-switches {
  max-width: 1500px;
  margin: 0 auto 28px;
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.catalog-switch {
  min-width: 180px;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid rgba(96, 165, 250, 0.16);
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.94), rgba(15, 23, 42, 0.78));
  text-decoration: none;
  color: #e2e8f0;
  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}

.catalog-switch:hover {
  transform: translateY(-2px);
  border-color: rgba(96, 165, 250, 0.4);
  box-shadow: 0 12px 28px rgba(2, 6, 23, 0.42);
}

.catalog-switch strong,
.catalog-switch span {
  display: block;
}

.catalog-switch strong {
  font-size: 14px;
  font-weight: 800;
  margin-bottom: 4px;
}

.catalog-switch span {
  font-size: 12px;
  color: rgba(191, 219, 254, 0.76);
}

.catalog-section {
  max-width: 1500px;
  margin: 0 auto 56px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 8px;
}

.section-heading h2 {
  font-size: 26px;
  font-weight: 800;
}

.section-heading span {
  color: rgba(191, 219, 254, 0.74);
  font-size: 13px;
  font-weight: 700;
}

.section-copy {
  margin-bottom: 18px;
  color: rgba(226,232,240,0.72);
  font-size: 14px;
  line-height: 1.5;
  max-width: 900px;
}

.catalog-group-stack {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.catalog-group {
  padding: 22px;
  border-radius: 20px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background:
    radial-gradient(circle at top right, rgba(96, 165, 250, 0.08), transparent 24%),
    linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(15, 23, 42, 0.74));
  box-shadow: 0 18px 44px rgba(2, 6, 23, 0.28);
}

.catalog-group-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.catalog-group-header h3 {
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 6px;
}

.catalog-group-header p {
  max-width: 840px;
  color: rgba(226, 232, 240, 0.68);
  font-size: 13px;
  line-height: 1.55;
}

.catalog-group-header span {
  flex-shrink: 0;
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.14);
  background: rgba(30, 41, 59, 0.68);
  color: rgba(191, 219, 254, 0.8);
  font-size: 12px;
  font-weight: 700;
}

/* ---------- Grid ---------- */
.collections-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px,1fr));
  gap: 16px;
}

/* ---------- Card ---------- */
.card {
  background: linear-gradient(135deg,#1e293b,#0f172a);
  border-radius: 16px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  color: inherit;
  text-decoration: none;
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  cursor: default;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.08);
  box-shadow: 0 10px 30px rgba(0,0,0,.5);
}

.card.link-card {
  cursor: pointer;
}

.card:hover {
  transform: translateY(-6px);
  border-color: rgba(96, 165, 250, 0.18);
  box-shadow: 0 20px 50px rgba(0,0,0,.8);
}

.card img {
  width: 100%;
  height: 220px;
  object-fit: contain;
  margin-bottom: 14px;
  padding: 8px;
  border-radius: 14px;
  background:
    radial-gradient(circle at top right, rgba(255,255,255,0.06), transparent 35%),
    linear-gradient(180deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.24));
  filter: drop-shadow(0 8px 18px rgba(0,0,0,.6));
}

.card-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
}

.card-pill {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  border: 1px solid rgba(148,163,184,0.26);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .02em;
}

.card-pill.neutral {
  background: rgba(148,163,184,0.14);
  color: rgba(226,232,240,0.86);
  border-color: rgba(148,163,184,0.2);
}

.card h3 {
  font-size: 16px;
  margin-bottom: 8px;
  line-height: 1.35;
  min-height: 44px;
}

.card span {
  font-size: 12px;
  opacity: .7;
  display: block;
  margin-top: auto;
}

/* ---------- No results ---------- */
.no-results {
  text-align: center;
  padding: 40px;
  font-size: 18px;
  opacity: .8;
}

/* ---------- Scrollbar for grid ---------- */
.collections-grid::-webkit-scrollbar {
  width: 8px;
}
.collections-grid::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.15);
  border-radius: 10px;
}

/* ---------- Responsive ---------- */
@media(max-width:768px){
  body {padding:30px 20px;}
  header h1 {font-size:32px;}
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }
  .catalog-group {
    padding: 18px;
  }
  .catalog-group-header {
    align-items: flex-start;
    flex-direction: column;
  }
}

body {
  padding: 44px 32px 72px;
}

.catalog-hero {
  max-width: 1500px;
  margin: 0 auto 28px;
  text-align: left;
}

.catalog-hero h1 {
  margin-bottom: 12px;
  font-size: clamp(38px, 4.8vw, 56px);
  line-height: 1;
  letter-spacing: -0.04em;
}

.catalog-hero p {
  margin: 0;
  max-width: 920px;
  color: rgba(226, 232, 240, 0.78);
  font-size: 18px;
  line-height: 1.65;
}

.search-bar {
  align-items: center;
  gap: 16px;
  max-width: none;
  margin: 28px 0 14px;
}

.search-input-wrap,
.search-select-wrap {
  display: flex;
  align-items: center;
  min-height: 62px;
  border-radius: 0;
  border: 0;
  background: rgba(2, 6, 23, 0.96);
  box-shadow: none;
}

.search-input-wrap {
  flex: 1 1 760px;
  gap: 14px;
  padding: 0 18px;
}

.search-input-wrap i {
  color: rgba(148, 163, 184, 0.82);
  font-size: 19px;
  flex-shrink: 0;
}

.search-input-wrap input,
.search-select-wrap select {
  -webkit-appearance: none;
  appearance: none;
  border: 0;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  outline: none !important;
}

.search-input-wrap input {
  flex: 1;
  min-width: 0;
  padding: 0;
  font-size: 17px;
  line-height: 1.2;
  color: #f8fafc;
  caret-color: #f8fafc;
}

.search-input-wrap input::placeholder {
  color: rgba(148, 163, 184, 0.88);
}

.search-select-wrap {
  flex: 0 1 250px;
  gap: 12px;
  padding: 0 16px;
  border-radius: 0 !important;
  overflow: hidden;
}

.search-select-wrap span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: rgba(191, 219, 254, 0.72);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.search-select-wrap select {
  flex: 1;
  min-width: 0;
  padding: 0;
  font-size: 15px;
  appearance: none;
  border-radius: 0 !important;
  color: #f8fafc !important;
  color-scheme: dark;
}

.search-select-wrap select option {
  color: #f8fafc !important;
  background: #020617 !important;
}

.search-select-wrap select::-ms-expand {
  display: none;
}

.results-meta {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  max-width: none;
  margin: 0;
}

.results-meta span {
  padding: 10px 14px;
  border-radius: 999px;
  border: 1px solid rgba(96, 165, 250, 0.14);
  background: rgba(15, 23, 42, 0.56);
  color: rgba(191, 219, 254, 0.84);
  font-size: 12px;
  font-weight: 700;
}

.catalog-switches {
  display: none;
}

.catalog-section {
  margin-bottom: 60px;
}

.section-heading h2 {
  font-size: 32px;
  letter-spacing: -0.03em;
}

.section-copy {
  font-size: 15px;
  color: rgba(226, 232, 240, 0.74);
}

.catalog-group {
  padding: 26px;
  border-radius: 24px;
}

.collections-grid {
  gap: 18px;
}

.card {
  padding: 18px 18px 20px;
  border-radius: 20px;
  border: 1px solid rgba(148, 163, 184, 0.1);
  background: linear-gradient(180deg, rgba(30, 41, 59, 0.94), rgba(15, 23, 42, 0.96));
}

.catalog-card-enter {
  opacity: 0;
  transform: translateY(14px) scale(0.985);
  animation: catalogCardIn 0.34s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  will-change: transform, opacity;
}

@keyframes catalogCardIn {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.card:hover {
  transform: translateY(-7px) scale(1.01);
  border-color: rgba(96, 165, 250, 0.24);
  box-shadow: 0 22px 48px rgba(2, 6, 23, 0.42);
}

.card img {
  height: 196px;
  margin-bottom: 16px;
  padding: 10px;
  border-radius: 18px;
  background:
    radial-gradient(circle at top right, rgba(255,255,255,0.08), transparent 32%),
    linear-gradient(180deg, rgba(30, 41, 59, 0.72), rgba(15, 23, 42, 0.34));
  transition: transform 0.28s ease, filter 0.28s ease;
}

.card:hover img {
  transform: translateY(-4px) scale(1.025);
  filter: drop-shadow(0 14px 26px rgba(0,0,0,.66));
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
  color: rgba(148, 163, 184, 0.92);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.card-meta-divider {
  color: rgba(100, 116, 139, 0.8);
}

.card-category {
  font-weight: 800;
}

.card h3 {
  min-height: 0;
  margin-bottom: 10px;
  font-size: 17px;
  line-height: 1.38;
}

.card-date {
  margin-top: auto;
  color: rgba(226, 232, 240, 0.72);
  font-size: 13px;
  opacity: 1;
}

@media (max-width: 900px) {
  .search-bar {
    flex-direction: column;
    align-items: stretch;
  }

  .search-input-wrap,
  .search-select-wrap {
    width: 100%;
    flex: 1 1 auto;
  }
}

@media (max-width: 768px) {
  body {
    padding: 28px 18px 52px;
  }

  .catalog-hero h1 {
    font-size: 34px;
  }

  .catalog-hero p {
    font-size: 15px;
  }

  .catalog-group {
    padding: 20px;
  }

  .card img {
    height: 172px;
  }
}

